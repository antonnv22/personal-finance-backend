# Скопируйте в .env и заполните реальными значениями:  cp .env.example .env
# .env закрыт в .gitignore и не должен попадать в репозиторий.

# --- Vault ---
# Токен для доступа к secret/personal-finance.
# Получить: vault token create -policy=<policy>
VAULT_TOKEN=

# --- PostgreSQL (контейнер из docker-compose.yml) ---
POSTGRES_DB=personal_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Порт на хосте: 5433, чтобы не конфликтовать с локально установленным Postgres на 5432
POSTGRES_HOST_PORT=5433

# --- Backend ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
BACKEND_PORT=8080

# --- Frontend ---
FRONTEND_PORT=8081
