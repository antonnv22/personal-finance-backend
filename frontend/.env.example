# Base URL used by the frontend to reach the backend REST API.
# - Local dev with `npm run dev`: Vite proxies /api to VITE_DEV_PROXY_TARGET, so
#   VITE_API_BASE_URL can stay as /api.
# - Docker/production build: nginx proxies /api to the backend service, so
#   VITE_API_BASE_URL should also stay as /api (same-origin, no CORS needed).
# - Only override with a full URL (e.g. http://localhost:8080/api) if the
#   frontend is served from a different origin than the reverse proxy.
VITE_API_BASE_URL=/api

# Target used only by the Vite dev server proxy (not baked into the build).
VITE_DEV_PROXY_TARGET=http://localhost:8080
